# normalize line endings for text; Unity YAML stays LF so diffs work on both machines
* text=auto
*.cs text diff=csharp
*.unity text
*.prefab text
*.asset text
*.mat text
*.meta text
*.anim text
*.controller text
*.inputactions text
*.json text
*.md text
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

